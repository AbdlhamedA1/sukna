# ---- Server runtime ----
NODE_ENV=development
PORT=5000

# ---- Database ----
MONGODB_URI=mongodb://localhost:27017/sukna

# ---- Auth secrets (use long random strings) ----
JWT_SECRET=change-me-to-a-long-random-string
OTP_SECRET=change-me-to-another-long-random-string
BCRYPT_SALT_ROUNDS=12

# ---- CORS / cookie origins ----
WEBSITE_URL=http://localhost:3000
DASHBOARD_URL=http://localhost:5173

# ---- Admin seeding (used by `npm run seed:admin`) ----
ADMIN_FULL_NAME=SUKNA Admin
ADMIN_EMAIL=admin@sukna.com
ADMIN_PASSWORD=change-me-strong-password

# ---- Cloudinary (Phase 5 media uploads) ----
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
